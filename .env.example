# Настройки собственного сервера (Oracle Cloud и т.п.). Скопируй в .env: cp .env.example .env
# Файл .env не попадает в git. Не присылай его никому: тут секреты.

# Ключи приложения EXBO (https://exbo.net/oauth). Без них сайт работает в демо-режиме.
EXBO_CLIENT_ID=
EXBO_CLIENT_SECRET=

# Какие регионы сканировать: ru,eu,na,sea. Меньше регионов — быстрее обходится каталог.
REGIONS=ru,eu

# Адрес и порт. За Caddy оставь 127.0.0.1; без Caddy поставь HOST=0.0.0.0.
HOST=127.0.0.1
PORT=3000

# 1, если перед сервером стоит Caddy/nginx (нужно для настоящих IP и https-кук).
TRUST_PROXY=1

# Где лежит база (по умолчанию ./data).
# DATA_DIR=data

# Фоновый сканер включён по умолчанию. 0 — выключить.
# BACKGROUND_SCAN=1

# База Turso (для Cloudflare Pages задаются в панели Cloudflare, здесь нужны только для `npm run db:turso`).
# TURSO_DATABASE_URL=libsql://имя-базы-логин.turso.io
# TURSO_AUTH_TOKEN=

# Чёрный список предметов (по умолчанию см. src/blacklist.js). Скрытые предметы не сканируются и не попадают
# в «Новые» и «Выгодные» лоты, но находятся поиском.
# BLACKLIST_OFF=1                       выключить чёрный список
# BLACKLIST_CATEGORIES=misc,supply/food заменить список категорий
# BLACKLIST_IDS=id1,id2                 добавить предметы по id
# BLACKLIST_NAMES=часть,схемы           добавить по фрагменту названия
# MODULE_ITEMS=id                       дополнительные предметы с названиями модулей
